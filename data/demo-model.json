{
  "id": "fixture",
  "label": "Analytic fixture",
  "name": "Hydro Assembly Fixture",
  "format": "3MF",
  "sourcePath": "./examples/models/assembly-demo.3mf",
  "components": [
    {
      "id": "fixture-vessel",
      "name": "Vessel",
      "type": "assembly",
      "parentId": null
    },
    {
      "id": "fixture-hull",
      "name": "Hull",
      "type": "hull",
      "parentId": "fixture-vessel"
    },
    {
      "id": "fixture-thruster",
      "name": "Main Thruster",
      "type": "thruster",
      "parentId": "fixture-vessel"
    }
  ],
  "componentRules": [
    {
      "match": "^Hull$",
      "type": "hull",
      "hydro": true
    },
    {
      "match": "Thruster",
      "type": "thruster",
      "hydro": false,
      "propulsion": {
        "diameter": 0.5,
        "thrust": 20000,
        "inflowSpeed": 3,
        "axis": [
          1,
          0,
          0
        ]
      }
    },
    {
      "match": "^Vessel$",
      "type": "assembly",
      "hydro": false
    }
  ],
  "hydro": {
    "density": 1025,
    "defaultDraft": 1.2,
    "minDraft": 0,
    "maxDraft": 2
  },
  "analysisCapabilities": {
    "model": {
      "enabled": true,
      "status": "fixture",
      "reason": "Deterministic ModelDocument fixture for rendering and component tests."
    },
    "hydro": {
      "enabled": true,
      "status": "fixture",
      "reason": "Analytic watertight fixture geometry is validated against closed-form hydrostatics."
    },
    "structure": {
      "enabled": true,
      "status": "fixture",
      "reason": "Dedicated deterministic 2D frame fixture is used for the Structure workspace."
    },
    "resistance": {
      "enabled": true,
      "status": "fixture",
      "reason": "Dedicated deterministic ITTC-1957 friction fixture is used for the Resistance workspace."
    },
    "propulsion": {
      "enabled": true,
      "status": "fixture",
      "reason": "Dedicated deterministic actuator-disk and semantic thruster fixture is used for the Propulsion workspace."
    }
  }
}
