  "analysisCapabilities": {
    "model": {
      "enabled": true,
      "status": "sourced",
      "reason": "Pinned NTNU/Shiplab Gunnerus geometry and semantic part metadata."
    },
    "hydro": {
      "enabled": false,
      "status": "awaiting hull validation",
      "reason": "The published lightweight glTF combines hull and structure and is intended for visualisation/teaching, not validated hydrostatics.",
      "requirements": [
        "validated watertight external hull surface",
        "known loading-condition displacement",
        "known KG/LCG/TCG for stability work"
      ]
    },
    "propulsion": {
      "enabled": false,
      "status": "identity only",
      "reason": "Thruster identity and rated power are sourced, but thrust maps, actuator diameter and local thrust axes are not yet configured.",
      "requirements": [
        "sourced or explicitly assumed thrust model",
        "actuator diameter",
        "local thrust-axis convention and transforms"
      ]
    },
    "structure": {
      "enabled": false,
      "status": "visual only",
      "reason": "The open glTF is a visual assembly and does not contain a validated beam/shell/solid FE idealisation.",
      "requirements": [
        "structural idealisation or FE mesh",
        "material properties and section/shell thickness",
        "supports, connections and load cases"
      ]
    },
    "resistance": {
      "enabled": false,
      "status": "not configured",
      "reason": "A resistance calculation needs a validated wetted surface/loading condition and a declared method scope.",
      "requirements": [
        "validated wetted surface for the selected draft",
        "water properties and reference length",
        "chosen resistance method or experimental/CFD source"
      ]
    }
  },
  "hydro": {
    "density": 1025,
    "defaultDraft": 2.7,
    "minDraft": 0,
    "maxDraft": 4.5,
    "enabled": false,
    "reason": "The published lightweight glTF is intended for visualisation/teaching and part00 combines hull and structure. Hydro is disabled until a watertight external hull surface is validated."
  }
