          "stern",
          "sourced-identity"
        ]
      },
      "hydro": false,
      "propulsion": {
        "type": "azimuth",
        "ratedPowerKw": 500,
        "forceModel": "unset"
      }
    },
    {
      "match": "^part20$",
      "semantic": {
